# Supabase-Zugangsdaten – findest du im Supabase-Dashboard unter
# Project Settings → API
# Danach diese Datei nach ".env" kopieren und die Werte eintragen.

VITE_SUPABASE_URL=https://dein-projekt.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=dein-publishable-key
